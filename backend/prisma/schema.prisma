// Autoza backend — Prisma schema
// Vehicle mirrors the existing frontend dataset (src/data/cars.json) field for
// field, so the seed script is a straight migration rather than a remodel.
// The one new field is `quantity`: each row is still a unique real used car
// (not a generic stock-keeping unit), so quantity starts at 1, a purchase
// sets it to 0 (sold), and an admin restock sets it back to 1.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon (and other pooled providers): migrations run over this *unpooled*
  // connection instead, since schema changes need a direct connection.
  // DATABASE_URL stays the pooled one the running app actually queries
  // through. Safe to leave DIRECT_URL unset/equal to DATABASE_URL for a
  // plain, unpooled Postgres (e.g. this sandbox's local dev database).
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev (whatever OS this is generated on); Vercel's
  // Node.js serverless functions run on Amazon Linux, which needs its own
  // prebuilt query engine binary — without this, deployed API calls fail
  // at runtime with "query engine not found", not at build time.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  USER
  ADMIN
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  vehicles     Vehicle[] @relation("ListedBy")

  purchaseRequests         PurchaseRequest[] @relation("Buyer")
  decidedPurchaseRequests  PurchaseRequest[] @relation("DecidedBy")
}

model Vehicle {
  id    String @id @default(uuid())
  // Human-friendly reference, e.g. "CAR-0001". Unique so re-running the seed
  // script is safe (upsert by stockNumber) instead of duplicating rows.
  stockNumber String @unique

  title   String
  make    String
  model   String
  variant String?
  year    Int

  price    Int
  quantity Int @default(1)
  mileage  Int

  fuelType           String?
  transmission       String?
  transmissionDetail String?
  gears              Int?
  drivetrain         String?
  bodyType           String

  engine          String?
  engineCapacityL Float?
  horsepower      Int?

  exteriorColor       String?
  exteriorColorFamily String?
  interiorColor       String?
  doors               Int?
  seats               Int?

  condition       String
  accidentHistory String?
  // { min, max, unit } — small and only ever read as a whole, so JSON here
  // avoids a one-row-per-vehicle side table for no real benefit.
  fuelEconomy     Json?

  // "pending" | "approved" | "rejected". Defaults to "approved" so this
  // column backfills the pre-existing seeded inventory as already-approved
  // when the migration first adds it; the repository layer overrides this
  // default to "pending" for every vehicle created through the public
  // "sell your car" flow (see prismaVehicleRepository.ts's create()) —
  // a new listing only appears in public listings once an admin approves it.
  approvalStatus String @default("approved")

  vin         String?
  sellerId    String?
  description String?

  // Array of { src, alt, kind, credit } — same reasoning as fuelEconomy.
  images Json

  listingStatus String    @default("available")
  listedAt      DateTime?
  dataFlags     String[]  @default([])
  sourceRow     Int?

  // Set only when a logged-in user lists their own car through the app
  // (the "sell your car" flow); null for the originally-seeded dataset.
  listedById String?
  listedBy   User?   @relation("ListedBy", fields: [listedById], references: [id])

  purchaseRequests PurchaseRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([make])
  @@index([bodyType])
  @@index([price])
  @@index([listingStatus])
  @@index([approvalStatus])
}

/**
 * A buyer's request to purchase a specific vehicle. Buying no longer
 * decrements stock on its own — it only records intent. An admin reviewing
 * the queue (GET /api/purchase-requests/pending) decides: approving one
 * decrements the vehicle's quantity (same rule the old instant-purchase
 * flow used), rejecting leaves the vehicle untouched. This is what lets a
 * buyer "send a request to the admin" instead of buying outright.
 */
model PurchaseRequest {
  id      String                @id @default(uuid())
  vehicle Vehicle               @relation(fields: [vehicleId], references: [id])
  vehicleId String
  buyer   User                  @relation("Buyer", fields: [buyerId], references: [id])
  buyerId String
  status  PurchaseRequestStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  decidedBy   User?     @relation("DecidedBy", fields: [decidedById], references: [id])
  decidedById String?

  @@index([vehicleId])
  @@index([buyerId])
  @@index([status])
}
