# Copy this file to .env and fill in real values. .env is git-ignored.

# PostgreSQL connection string for Prisma (added in the next phase).
# Example (Neon/Supabase-style hosted Postgres): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Port the Express server listens on locally (Vercel ignores this in production).
PORT=4000

# Secret used to sign JWTs (added in the auth phase). Use a long random string.
JWT_SECRET=
